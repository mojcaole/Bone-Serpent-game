    // warm harvest glow
    const gl=ctx.createRadialGradient(0,0,r*.2,0,0,r*2);
    gl.addColorStop(0,`rgba(255,205,80,${.3*alpha})`); gl.addColorStop(1,'rgba(255,205,80,0)');
    ctx.fillStyle=gl; ctx.beginPath(); ctx.arc(0,0,r*2,0,7); ctx.fill();
    // time-left ring
    const rr=r*1.25;
    ctx.lineWidth=2; ctx.lineCap='round';
    ctx.strokeStyle='rgba(255,240,220,.12)'; ctx.beginPath(); ctx.arc(0,0,rr,0,7); ctx.stroke();
    ctx.strokeStyle = warn ? `rgba(255,96,64,${.55+.45*alpha})` : 'rgba(255,214,120,.85)';
    ctx.beginPath(); ctx.arc(0,0,rr,-Math.PI/2,-Math.PI/2+frac*Math.PI*2); ctx.stroke();
 
    ctx.globalAlpha=alpha; ctx.scale(pop,pop);
    // contact shadow (not rotated)
    ctx.fillStyle='rgba(0,0,0,.32)'; ctx.beginPath(); ctx.ellipse(r*.15,r*1.0,r*.75,r*.13,0,0,7); ctx.fill();
    ctx.rotate(tilt);
 
    // back husk leaf
    huskLeaf(r,1,.62,.95,['#4f7d2c','#3d6a22','#6e9a3c']);
 
    // cob
    const w=r*.5;
    ctx.save(); cobPath(r);
    ctx.fillStyle='#c98a0c'; ctx.fill();
    ctx.clip();
    const kw=r*.25, kh=r*.205;
    for(let row=0, y=-r*1.02; y<r*.82; row++, y+=kh){
      const off = row%2 ? kw*.5 : 0;
      for(let x=-w-kw+off; x<w+kw; x+=kw){
        const cxk=x+kw/2, e=Math.min(1,Math.abs(cxk)/w);           // 0 at centre, 1 at the edge
        const lit = 1-e*e*.65;
        ctx.fillStyle=`rgb(${Math.round(255*lit+40*(1-lit))},${Math.round(212*lit+20*(1-lit))},${Math.round(70*lit)})`;
        const kx=x+kw*.08, ky=y+kh*.1, kW=kw*.84, kH=kh*.82, rad=Math.min(kW,kH)*.45;
        ctx.beginPath();
        ctx.moveTo(kx+rad,ky); ctx.lineTo(kx+kW-rad,ky); ctx.quadraticCurveTo(kx+kW,ky,kx+kW,ky+rad);
        ctx.lineTo(kx+kW,ky+kH-rad); ctx.quadraticCurveTo(kx+kW,ky+kH,kx+kW-rad,ky+kH);
        ctx.lineTo(kx+rad,ky+kH); ctx.quadraticCurveTo(kx,ky+kH,kx,ky+kH-rad);
        ctx.lineTo(kx,ky+rad); ctx.quadraticCurveTo(kx,ky,kx+rad,ky); ctx.fill();
        if(e<.6){ ctx.fillStyle=`rgba(255,250,215,${.55*(1-e)})`; ctx.beginPath(); ctx.ellipse(kx+kW*.35,ky+kH*.32,kW*.16,kH*.14,0,0,7); ctx.fill(); }
      }
    }
    // cylinder shading: darker edges, a shine stripe left of centre
    const cyl=ctx.createLinearGradient(-w,0,w,0);
    cyl.addColorStop(0,'rgba(90,40,0,.45)'); cyl.addColorStop(.3,'rgba(255,255,220,.0)'); cyl.addColorStop(.36,'rgba(255,255,230,.28)');
    cyl.addColorStop(.46,'rgba(255,255,220,0)'); cyl.addColorStop(.8,'rgba(90,40,0,.12)'); cyl.addColorStop(1,'rgba(90,40,0,.5)');
    ctx.fillStyle=cyl; ctx.fillRect(-w,-r*1.1,w*2,r*2);
    ctx.restore();
    cobPath(r); ctx.strokeStyle='rgba(110,55,0,.6)'; ctx.lineWidth=.8; ctx.stroke();
 
    // silk at the tip
    ctx.lineCap='round'; ctx.lineWidth=.9;
    [[-.22,'#e8cf96'],[0,'#c9874a'],[.2,'#e8cf96'],[.1,'#a8603a']].forEach(([dx,col],i)=>{
      const sway = reduce ? 0 : Math.sin(t/300+i)*r*.05;
      ctx.strokeStyle=col; ctx.beginPath(); ctx.moveTo(dx*r*.4,-r*.98);
      ctx.quadraticCurveTo(dx*r*1.3+sway,-r*1.18, dx*r*1.9+sway*1.5,-r*1.32); ctx.stroke();
    });
 
    // front husk leaves and the stalk
    huskLeaf(r,-1,.5,.9,['#5c8f33','#4a7c28','#86b04a']);
    ctx.fillStyle='#6b7a2a'; ctx.strokeStyle='rgba(30,35,10,.6)'; ctx.lineWidth=.8;
    ctx.beginPath(); ctx.moveTo(-r*.13,r*.98); ctx.lineTo(r*.13,r*.98); ctx.lineTo(r*.1,r*1.2); ctx.lineTo(-r*.1,r*1.2); ctx.closePath(); ctx.fill(); ctx.stroke();
    ctx.fillStyle='#8a9a3a'; ctx.beginPath(); ctx.ellipse(0,r*1.2,r*.1,r*.04,0,0,7); ctx.fill();
    ctx.restore();
 
    // twinkle
    if(!reduce){
      const tw=Math.max(0,Math.sin(t/240));
      if(tw>.2){
        ctx.save(); ctx.translate(cx+r*.75,cy+bob-r*.75); ctx.scale(tw,tw); ctx.globalAlpha=alpha;
        ctx.fillStyle='rgba(255,250,230,.95)'; ctx.beginPath();
        for(let i=0;i<4;i++){ const a=i*Math.PI/2; ctx.lineTo(Math.cos(a)*r*.28,Math.sin(a)*r*.28); ctx.lineTo(Math.cos(a+Math.PI/4)*r*.07,Math.sin(a+Math.PI/4)*r*.07); }
        ctx.closePath(); ctx.fill(); ctx.restore();
      }
    }
  }
  function drawStone(x,y){
    const px=x*S, py=y*S;
    ctx.fillStyle='rgba(0,0,0,.35)'; ctx.beginPath(); ctx.ellipse(px+S/2,py+S*.92,S*.42,S*.1,0,0,7); ctx.fill();
    ctx.fillStyle='#5b5070';
    ctx.beginPath(); ctx.moveTo(px+S*.16,py+S*.9); ctx.lineTo(px+S*.16,py+S*.42);
    ctx.arc(px+S/2,py+S*.42,S*.34,Math.PI,0); ctx.lineTo(px+S*.84,py+S*.9); ctx.closePath(); ctx.fill();
    ctx.fillStyle='#3d3450'; ctx.fillRect(px+S*.16,py+S*.82,S*.68,S*.08);
    ctx.fillStyle='rgba(236,227,207,.55)'; ctx.font=`bold ${S*.22}px Georgia,serif`; ctx.textAlign='center';
    ctx.fillText('RIP',px+S/2,py+S*.58);
  }
  function drawSnake(dead){
    const n=snake.length;
    // spine cord
    ctx.strokeStyle= dead ? 'rgba(160,140,140,.5)' : 'rgba(142,240,176,.18)';
    ctx.lineWidth=S*.5; ctx.lineCap='round'; ctx.lineJoin='round';
    ctx.beginPath(); snake.forEach((s,i)=>{ const X=s.x*S+S/2,Y=s.y*S+S/2; i?ctx.lineTo(X,Y):ctx.moveTo(X,Y); }); ctx.stroke();
    for(let i=n-1;i>=1;i--){
      const s=snake[i], cx=s.x*S+S/2, cy=s.y*S+S/2;
      const k=1-i/(n+4)*.55, r=S*.36*k;
      const prev=snake[i-1]; const horiz = prev.y===s.y;
      ctx.fillStyle= dead ? '#9e9387' : '#ece3cf';
      // vertebra: body + side processes
      ctx.beginPath(); ctx.ellipse(cx,cy,horiz?r*.75:r,horiz?r:r*.75,0,0,7); ctx.fill();
      ctx.fillStyle= dead ? '#7d7368' : '#c9bc9f';
      if(horiz){ ctx.fillRect(cx-r*.18,cy-r*1.25,r*.36,r*2.5); } else { ctx.fillRect(cx-r*1.25,cy-r*.18,r*2.5,r*.36); }
      ctx.fillStyle= dead ? '#9e9387' : '#ece3cf';
      ctx.beginPath(); ctx.arc(cx,cy,r*.55,0,7); ctx.fill();
    }
    // skull head
    const h=snake[0], cx=h.x*S+S/2, cy=h.y*S+S/2, [dx,dy]=DIRS[dir];
    ctx.save(); ctx.translate(cx,cy); ctx.rotate(Math.atan2(dy,dx));
    ctx.fillStyle= dead ? '#b5aa98' : '#f6efdd';
    ctx.beginPath(); ctx.ellipse(-S*.04,0,S*.5,S*.46,0,0,7); ctx.fill();
    ctx.fillRect(S*.12,-S*.26,S*.3,S*.52);
    // teeth
    ctx.fillStyle='#1d1530';
    for(let i=-2;i<=1;i++) ctx.fillRect(S*.36,i*S*.11+S*.02,S*.07,S*.07);
    // eye sockets
    ctx.fillStyle='#120d1c';
    ctx.beginPath(); ctx.ellipse(S*.04,-S*.19,S*.13,S*.11,0,0,7); ctx.ellipse(S*.04,S*.19,S*.13,S*.11,0,0,7); ctx.fill();
    if(!dead){
      const glow = reduce?1:.7+.3*Math.sin(t/150);
      ctx.fillStyle=`rgba(142,240,176,${glow})`; ctx.shadowColor='#8ef0b0'; ctx.shadowBlur=10;
      ctx.beginPath(); ctx.arc(S*.06,-S*.19,S*.05,0,7); ctx.arc(S*.06,S*.19,S*.05,0,7); ctx.fill(); ctx.shadowBlur=0;
    } else {
      ctx.strokeStyle='#ff7a1a'; ctx.lineWidth=2;
      for(const yy of [-.19,.19]){ ctx.beginPath(); ctx.moveTo(0,(yy-.06)*S); ctx.lineTo(S*.1,(yy+.06)*S); ctx.moveTo(S*.1,(yy-.06)*S); ctx.lineTo(0,(yy+.06)*S); ctx.stroke(); }
    }
    ctx.restore();
  }
  function draw(){
    drawBackground();
    stones.forEach(s=>drawStone(s.x,s.y));
    if(food) drawPumpkin(food.x*S+S/2, food.y*S+S/2+(reduce?0:Math.sin(t/300)*1.5), S*.42, true);
    if(corn) drawCorn(corn.x*S+S/2, corn.y*S+S/2, S*.4, corn.ttl);
    const won = state==='dead' && lastFate==='full';
    drawSnake(state==='dead' && !won);
    if(won && !reduce && t-deathAt<1400){
      // green glow rising from the serpent for a win
      const k=(t-deathAt)/1400, g=ctx.createRadialGradient(300,300,40,300,300,420);
      g.addColorStop(0,`rgba(142,240,176,${.28*(1-k)})`); g.addColorStop(1,'rgba(142,240,176,0)');
      ctx.fillStyle=g; ctx.fillRect(0,0,600,600);
    } else if(state==='dead' && !won && !reduce && t-deathAt<300){ ctx.fillStyle=`rgba(255,80,20,${.3*(1-(t-deathAt)/300)})`; ctx.fillRect(0,0,600,600); }
  }
 
  function loop(ts){
    const raw = last ? ts-last : 16.7, dt = last ? Math.min(raw,100) : 0; last=ts; t=ts; frameDt=dt;
    watchFrameRate(raw);
    if(state==='play'){ elapsed+=dt; tickClock(); acc+=dt; const sp=speed(); while(acc>=sp && state==='play'){ acc-=sp; step(); } }
    draw();
    requestAnimationFrame(loop);
  }
 
  // ---------- Input ----------
  const KEY = {ArrowUp:'up',KeyW:'up',ArrowDown:'down',KeyS:'down',ArrowLeft:'left',KeyA:'left',ArrowRight:'right',KeyD:'right'};
  // Outside a running game, keys only start one when the board is on screen and you are not using another control.
  const board=$('board');
  function boardInView(){ const r=board.getBoundingClientRect(); return Math.min(r.bottom,innerHeight)-Math.max(r.top,0) >= r.height*.5; }
  function busyElsewhere(){ const a=document.activeElement; return a && a!==document.body && !board.contains(a); }
  const mayStart = () => boardInView() && !busyElsewhere();
  addEventListener('keydown',e=>{
    if(KEY[e.code]){
      if(state==='play'){ e.preventDefault(); turn(KEY[e.code]); }
      else if(state!=='paused' && mayStart()){ e.preventDefault(); start(); turn(KEY[e.code]); }
    }
    else if(['Digit1','Digit2','Digit3','Numpad1','Numpad2','Numpad3'].includes(e.code) && state!=='play' && state!=='paused'){
      setLevel(['easy','medium','fast'][+e.code.slice(-1)-1]);
    }
    else if(e.code==='Space'){
      if(state==='play'||state==='paused'){ e.preventDefault(); pause(); }
      else if(mayStart()){ e.preventDefault(); start(); }
    }
  });
  $('startBtn').addEventListener('click',start);
  document.querySelectorAll('#levels button').forEach(b=>b.addEventListener('click',()=>setLevel(b.dataset.level)));
  $('levels').addEventListener('keydown',e=>{
    if(e.key!=='ArrowLeft'&&e.key!=='ArrowRight') return;
    e.stopPropagation(); e.preventDefault();
    const order=['easy','medium','fast'], i=order.indexOf(level)+(e.key==='ArrowRight'?1:-1);
    if(order[i]){ setLevel(order[i]); document.querySelector(`#levels [data-level="${order[i]}"]`).focus(); }
  });
  setLevel(level);
  setBolt(boltOn);
  if(lite) setLite(true);
  document.querySelectorAll('.pad button[data-d]').forEach(b=>b.addEventListener('pointerdown',e=>{
    e.preventDefault(); if(state==='play') turn(b.dataset.d); }));
  $('padPause').addEventListener('click',()=>{ if(state==='play'||state==='paused') pause(); });
  // Swipes turn as soon as the finger has moved far enough, and one gesture can chain several turns.
  let sx=0, sy=0, swiping=false;
  board.addEventListener('touchstart',e=>{ const p=e.touches[0]; sx=p.clientX; sy=p.clientY; swiping=true; },{passive:true});
  board.addEventListener('touchmove',e=>{
    if(!swiping || state!=='play') return;
    const p=e.touches[0], dx=p.clientX-sx, dy=p.clientY-sy;
    if(Math.max(Math.abs(dx),Math.abs(dy))<18) return;
    turn(Math.abs(dx)>Math.abs(dy) ? (dx>0?'right':'left') : (dy>0?'down':'up'));
    sx=p.clientX; sy=p.clientY;
  },{passive:true});
  board.addEventListener('touchend',()=>{ swiping=false; },{passive:true});
  board.addEventListener('touchcancel',()=>{ swiping=false; },{passive:true});
  document.addEventListener('visibilitychange',()=>{ if(document.hidden && state==='play') pause(); });
 
  reset();
  requestAnimationFrame(loop);
})();
</script>
 
