<title>Bone Serpent</title>
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Creepster&family=Spectral:ital,wght@0,400;0,600;1,400&display=swap">
<style>
/* Layout: one centered column — moonlit header, the graveyard board, a tombstone-plaque scoreline, d-pad for touch */
:root{
  color-scheme: dark;
  --night:#120d1c;        /* page ground, violet-black */
  --crypt:#1d1530;        /* panels */
  --moss:#2c2342;         /* lines, grid */
  --bone:#ece3cf;         /* text, snake */
  --pumpkin:#ff7a1a;      /* accent */
  --ember:#ffb347;        /* highlight */
  --ectoplasm:#8ef0b0;    /* ghost glow, ok state */
  --dim:#a69cbb;          /* secondary text */
  --display:"Creepster", "Chiller", fantasy, cursive;
  --body:"Spectral", Georgia, "Times New Roman", serif;
}
[hidden]{display:none!important}
.sr-only{position:absolute; width:1px; height:1px; padding:0; margin:-1px; overflow:hidden; clip:rect(0 0 0 0); white-space:nowrap; border:0}
body{
  background: radial-gradient(120% 80% at 50% -10%, #2a1d44 0%, var(--night) 60%) fixed, var(--night);
  color:var(--bone); font-family:var(--body); font-size:16px;
  padding-inline:16px; padding-block:20px 28px;
}
.wrap{width:100%; max-width:560px; margin-inline:auto; display:flex; flex-direction:column; gap:14px}
.wrap > *{flex-shrink:0; min-width:0}
header{display:flex; align-items:flex-end; justify-content:space-between; gap:12px; flex-wrap:wrap}
h1{font-family:var(--display); font-weight:400; font-size:clamp(2.4rem, 9vw, 3.4rem); line-height:.9; margin:0;
   color:var(--pumpkin); letter-spacing:.02em; text-shadow:0 0 18px rgba(255,122,26,.35); text-wrap:balance}
.tag{margin:4px 0 0; color:var(--dim); font-style:italic; font-size:.95rem}
.scores{display:flex; gap:10px}
@media (max-width:400px){ .scores{gap:8px} .plaque{min-width:76px; padding-inline:10px} }
.plaque{background:var(--crypt); border:1px solid var(--moss); border-radius:14px 14px 4px 4px; box-sizing:border-box;
  padding:6px 14px 8px; min-width:84px; text-align:center}
.plaque span{display:block; font-size:.68rem; letter-spacing:.14em; text-transform:uppercase; color:var(--dim)}
.plaque b{font-family:var(--display); font-weight:400; font-size:1.7rem; color:var(--bone); font-variant-numeric:tabular-nums}
.board{position:relative; box-sizing:border-box; width:100%; aspect-ratio:1/1; max-width:100%; border-radius:10px; overflow:hidden;
  border:1px solid var(--moss); box-shadow:0 20px 60px rgba(0,0,0,.55), 0 0 0 4px rgba(44,35,66,.35);
  touch-action:none; background:var(--night)}
canvas{display:block; width:100%; height:100%}
.overlay{z-index:2; position:absolute; inset:0; display:flex; flex-direction:column; align-items:center; justify-content:center;
  gap:10px; text-align:center; padding:20px; background:rgba(14,9,22,.62); backdrop-filter:blur(1.5px)}
.overlay h2{font-family:var(--display); font-weight:400; font-size:clamp(2rem,8vw,3rem); margin:0; color:var(--ember); text-wrap:balance}
.overlay p{margin:0; max-width:34ch; color:var(--bone); line-height:1.45}
.overlay .small{font-size:.85rem; color:var(--dim)}
.levels{display:flex; gap:4px; padding:4px; background:rgba(29,21,48,.85); border:1px solid var(--moss); border-radius:999px}
.levels button{border:0; background:none; color:var(--dim); padding:6px 16px; border-radius:999px; font-weight:600; font-size:.92rem; letter-spacing:.03em}
.levels button:hover{color:var(--bone)}
.levels button[aria-checked="true"]{color:var(--night)}
.levels button[data-level="easy"][aria-checked="true"]{background:var(--ectoplasm)}
.levels button[data-level="medium"][aria-checked="true"]{background:var(--ember)}
.levels button[data-level="fast"][aria-checked="true"]{background:var(--pumpkin)}
.lvl-note{font-size:.85rem; color:var(--dim); margin:0; min-height:1.2em}
.lvl-chip{position:absolute; top:10px; left:10px; z-index:3; pointer-events:none; padding:3px 10px; border-radius:999px;
  font-size:.68rem; letter-spacing:.14em; text-transform:uppercase; font-weight:600; background:rgba(14,9,22,.7); border:1px solid var(--moss);
  transition:opacity .6s ease}
.lvl-chip.faded{opacity:0}
.lvl-chip.easy{color:var(--ectoplasm)} .lvl-chip.medium{color:var(--ember)} .lvl-chip.fast{color:var(--pumpkin)}
.lvl-sub{display:none; font-size:.72rem; letter-spacing:.06em; color:var(--dim)}
.lvl-easy{color:var(--ectoplasm)} .lvl-medium{color:var(--ember)} .lvl-fast{color:var(--pumpkin)}
@media (prefers-reduced-motion: reduce){ .lvl-chip{transition:none} }
button{font:inherit; cursor:pointer}
.btn{background:var(--pumpkin); color:#1a0e04; border:0; border-radius:999px; padding:10px 26px; font-weight:600;
  font-size:1rem; letter-spacing:.04em; box-shadow:0 0 24px rgba(255,122,26,.45)}
.btn:hover{background:var(--ember)}
button:focus-visible{outline:2px solid var(--ectoplasm); outline-offset:3px}
.legend{display:flex; flex-wrap:wrap; gap:8px 18px; font-size:.88rem; color:var(--dim); margin:0; padding:0; list-style:none}
.legend li{display:flex; align-items:center; gap:6px}
.legend i{font-style:normal; display:inline-block; width:14px; height:14px; border-radius:50%}
.legend .cc{width:17px; height:17px; flex-shrink:0; margin-inline:-1.5px}
.pad{display:none; grid-template-columns:repeat(3,64px); grid-template-rows:repeat(2,56px); gap:8px; justify-content:center}
.pad button{background:var(--crypt); color:var(--bone); border:1px solid var(--moss); border-radius:12px;
  display:flex; align-items:center; justify-content:center; padding:0}
.pad svg{width:24px; height:24px; fill:currentColor}
.pad .pause{grid-column:3; grid-row:1; color:var(--dim)}
.pad .pause svg{width:20px; height:20px}
.pad button:active{background:var(--moss)}
.pad .up{grid-column:2; grid-row:1}
.touch-only{display:none}
@media (pointer:coarse){ .touch-only{display:inline} .key-only{display:none} }
.pad .left{grid-column:1; grid-row:2}.pad .down{grid-column:2; grid-row:2}.pad .right{grid-column:3; grid-row:2}
@media (pointer:coarse){ .pad{display:grid} }
.hint{font-size:.85rem; color:var(--dim); margin:0}
.settings{display:flex; flex-wrap:wrap; align-items:center; gap:8px}
.toggle{display:inline-flex; align-items:center; gap:7px; background:none; border:1px solid var(--moss); color:var(--dim);
  border-radius:999px; padding:5px 12px 5px 9px; font-size:.82rem}
.toggle:hover{color:var(--bone); border-color:var(--dim)}
.toggle .dot{width:9px; height:9px; border-radius:50%; border:1.5px solid currentColor; box-sizing:border-box}
.toggle[aria-pressed="true"]{color:var(--bone); border-color:#4a3c70}
.toggle[aria-pressed="true"] .dot{background:var(--ectoplasm); border-color:var(--ectoplasm)}
.toggle:disabled{opacity:.5; cursor:default}
.fx-note{font-size:.8rem; color:var(--dim); font-style:italic}
.ledger{display:flex; flex-direction:column; gap:12px; margin-top:10px; padding-top:18px; border-top:1px solid var(--moss)}
.ledger-head{display:flex; align-items:baseline; justify-content:space-between; gap:12px; flex-wrap:wrap}
.ledger h2{font-family:var(--display); font-weight:400; font-size:1.9rem; margin:0; color:var(--bone); letter-spacing:.02em}
.ghost{background:none; border:1px solid var(--moss); color:var(--dim); border-radius:999px; padding:5px 14px; font-size:.85rem}
.ghost:hover{color:var(--bone); border-color:var(--dim)}
.ghost.danger{border-color:var(--pumpkin); color:var(--pumpkin)}
.confirm{display:flex; align-items:center; gap:8px; flex-wrap:wrap; font-size:.9rem; color:var(--bone)}
.stats-for{margin:0; font-size:.72rem; letter-spacing:.12em; text-transform:uppercase; font-weight:600}
.stats{display:grid; grid-template-columns:repeat(4,1fr); gap:8px}
.stat{background:var(--crypt); border:1px solid var(--moss); border-radius:8px; padding:8px 10px; min-width:0}
.stat span{display:block; font-size:.66rem; letter-spacing:.12em; text-transform:uppercase; color:var(--dim)}
.stat b{font-size:1.25rem; font-weight:600; font-variant-numeric:tabular-nums; color:var(--bone)}
@media (max-width:440px){ .stats{grid-template-columns:repeat(2,1fr)} }
.table-wrap{overflow-x:auto; border:1px solid var(--moss); border-radius:8px}
table{width:100%; border-collapse:collapse; font-size:.92rem; font-variant-numeric:tabular-nums}
th,td{padding:7px 10px; text-align:left; white-space:nowrap}
th{font-size:.68rem; letter-spacing:.12em; text-transform:uppercase; color:var(--dim); font-weight:400; background:var(--crypt)}
td.num,th.num{text-align:right}
tbody tr+tr td{border-top:1px solid rgba(44,35,66,.7)}
tr.latest td{background:rgba(255,122,26,.08)}
.fate{display:inline-block; padding:1px 8px; border-radius:999px; font-size:.78rem; border:1px solid var(--moss); color:var(--dim)}
.fate.wall{color:#c9b8ff; border-color:#4a3c70}
.fate.stone{color:#b3a7c7; border-color:#5b5070}
.fate.self{color:var(--bone); border-color:#6d6252}
.fate.full{color:var(--ectoplasm); border-color:#3f7a58}
.star{color:var(--ember)}
@media (max-width:520px){
  .opt{display:none}
  .lvl-sub{display:block}
  th,td{padding:7px 6px}
  th:last-child,td:last-child{padding-right:10px; line-height:1.25}
  .tm{display:block; color:var(--dim)}
  table{font-size:.86rem}
}
@media (max-width:380px){ .opt-xs{display:none} }
.empty{padding:16px; color:var(--dim); font-style:italic; text-align:center}
kbd{font-family:var(--body); background:var(--crypt); border:1px solid var(--moss); border-radius:4px; padding:0 5px; color:var(--bone)}
</style>
 
<div class="wrap">
  <header>
    <div>
      <h1>Bone Serpent</h1>
      <p class="tag">Slither through the graveyard. Eat the pumpkins. Don't bite your own bones.</p>
    </div>
    <div class="scores">
      <div class="plaque"><span>Souls</span><b id="score">0</b></div>
      <div class="plaque"><span>Time</span><b id="clock">0:00</b></div>
      <div class="plaque"><span>Best</span><b id="best">0</b></div>
    </div>
  </header>
 
  <div class="board" id="board">
    <div class="lvl-chip medium faded" id="lvlChip">Medium</div>
    <canvas id="c" width="600" height="600" aria-label="Snake game board"></canvas>
    <div class="overlay" id="overlay">
      <h2 id="ovTitle">Rise from the grave</h2>
      <p id="ovText">Pumpkins grow your spine. Corn is worth 3 but vanishes fast. A new tombstone rises every 5 pumpkins.</p>
      <div class="levels" id="levels" role="radiogroup" aria-label="Level">
        <button type="button" role="radio" data-level="easy" aria-checked="false">Easy</button>
        <button type="button" role="radio" data-level="medium" aria-checked="true">Medium</button>
        <button type="button" role="radio" data-level="fast" aria-checked="false">Fast</button>
      </div>
      <p class="lvl-note" id="lvlNote"></p>
      <button class="btn" id="startBtn">Start haunting</button>
      <p class="small"><span class="key-only">Arrows or WASD to steer · Space to pause · 1 2 3 pick a level</span><span class="touch-only">Swipe the board or use the arrows below</span></p>
    </div>
  </div>
 
  <div class="pad" aria-label="Game controls">
    <button class="up" data-d="up" aria-label="Up"><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M12 6l7 11H5z"/></svg></button>
    <button class="pause" id="padPause" aria-label="Pause"><svg viewBox="0 0 24 24" aria-hidden="true"><rect x="6.5" y="5" width="4" height="14" rx="1"/><rect x="13.5" y="5" width="4" height="14" rx="1"/></svg></button>
    <button class="left" data-d="left" aria-label="Left"><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M6 12l11-7v14z"/></svg></button>
    <button class="down" data-d="down" aria-label="Down"><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M12 18L5 7h14z"/></svg></button>
    <button class="right" data-d="right" aria-label="Right"><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M18 12L7 19V5z"/></svg></button>
  </div>
 
  <ul class="legend">
    <li><i style="background:var(--pumpkin)"></i>Pumpkin · 1 soul</li>
    <li><svg class="cc" viewBox="0 0 24 24" aria-hidden="true"><defs><clipPath id="cobClip"><ellipse cx="12" cy="10.5" rx="3.7" ry="8.2"/></clipPath></defs><g transform="rotate(-24 12 12)"><path d="M12.6 21.5C15.8 17 17.2 12.3 16.8 8.2 15.2 12.3 14 16 12.2 19.6Z" fill="#3d6a22"/><ellipse cx="12" cy="10.5" rx="3.7" ry="8.2" fill="#ffd34a"/><g clip-path="url(#cobClip)" stroke="#c98a0c" stroke-width=".75"><path d="M7 5h10M7 8h10M7 11h10M7 14h10M7 17h10"/><path d="M10.2 1v20M13.8 1v20"/></g><ellipse cx="12" cy="10.5" rx="3.7" ry="8.2" fill="none" stroke="rgba(110,55,0,.6)" stroke-width=".8"/><path d="M12 2.4c-.4-1 -1.2-1.6-2-1.8M12 2.4c.3-1 .9-1.6 1.8-1.9" stroke="#c9874a" stroke-width=".8" fill="none" stroke-linecap="round"/><path d="M11.4 21.6C7.6 17.2 6.6 12.6 7.2 8.6 9.2 12.6 10.6 16.2 12.6 19.8Z" fill="#5c8f33"/><rect x="11.1" y="20.6" width="1.8" height="2.6" rx=".4" fill="#6b7a2a"/></g></svg>Corn · 3 souls</li>
    <li><i style="background:#5b5070"></i>Tombstone · deadly</li>
  </ul>
  <div class="settings" role="group" aria-label="Display settings">
    <button type="button" class="toggle" id="fxBtn" aria-pressed="false"><span class="dot" aria-hidden="true"></span>Light effects</button>
    <button type="button" class="toggle" id="boltBtn" aria-pressed="true"><span class="dot" aria-hidden="true"></span>Lightning</button>
    <span class="fx-note" id="fxNote" aria-live="polite"></span>
  </div>
  <p class="hint">The serpent speeds up as it grows. <span class="key-only">Press <kbd>Space</kbd> to pause.</span><span class="touch-only">Tap the pause button to take a break.</span></p>
 
  <section class="ledger" aria-labelledby="ledgerTitle">
    <div class="ledger-head">
      <h2 id="ledgerTitle">Book of the Dead</h2>
      <div id="clearArea">
        <button class="ghost" id="clearBtn" type="button">Clear history</button>
      </div>
    </div>
    <p class="stats-for" id="statsFor">Totals for Medium games</p>
    <div class="stats">
      <div class="stat"><span>Games</span><b id="stGames">0</b></div>
      <div class="stat"><span>Average</span><b id="stAvg">0</b></div>
      <div class="stat"><span>Longest run</span><b id="stTime">0:00</b></div>
      <div class="stat"><span>Longest spine</span><b id="stLong">0</b></div>
    </div>
    <div class="table-wrap">
      <table>
        <thead><tr><th class="num opt-xs">#</th><th class="opt">Level</th><th class="num">Souls</th><th class="num">Time</th><th class="num opt">Bones</th><th class="num opt">Pumpkins</th><th class="num opt">Corn</th><th>Fate</th><th>When</th></tr></thead>
        <tbody id="ledgerBody"></tbody>
      </table>
    </div>
  </section>
</div>
<p class="sr-only" id="announce" aria-live="polite"></p>
 
<script>
(() => {
  const N = 20, cv = document.getElementById('c');
  let ctx = cv.getContext('2d');
  const DPR = Math.min(2, window.devicePixelRatio || 1);
  cv.width = cv.height = Math.round(600 * DPR);
  ctx.setTransform(DPR,0,0,DPR,0,0);
  const S = 600 / N;
  const $ = id => document.getElementById(id);
  const reduce = matchMedia('(prefers-reduced-motion: reduce)').matches;
  const DIRS = {up:[0,-1], down:[0,1], left:[-1,0], right:[1,0]};
 
  // ---------- Levels ----------
  const LEVELS = {
    easy:   {name:'Easy',   start:190, perBone:1.6, min:110, stoneEvery:8, cornLife:65, note:'A slow serpent. Corn lingers longer.'},
    medium: {name:'Medium', start:140, perBone:2.2, min:60,  stoneEvery:5, cornLife:45, note:'The classic pace. Speeds up as you grow.'},
    fast:   {name:'Fast',   start:95,  perBone:2.2, min:42,  stoneEvery:4, cornLife:32, note:'A frantic serpent. Corn vanishes quickly.'},
  };
  const store = {
    get(k){ try { return localStorage.getItem(k); } catch(e) { return null; } },
    set(k,v){ try { localStorage.setItem(k,v); } catch(e) {} },
    del(k){ try { localStorage.removeItem(k); } catch(e) {} },
  };
  // one-time move of the old single best score to Medium, the pace it was set on
  if (store.get('boneSerpentBest') !== null && store.get('boneSerpentBest_medium') === null) store.set('boneSerpentBest_medium', store.get('boneSerpentBest'));
  store.del('boneSerpentBest');
  let level = LEVELS[store.get('boneSerpentLevel')] ? store.get('boneSerpentLevel') : 'medium';
  let gameLevel = level;
  const LV = () => LEVELS[gameLevel];
  const bestFor = l => +store.get('boneSerpentBest_'+l) || 0;
  let best = bestFor(level);
  $('best').textContent = best;
  function setLevel(l){
    if (!LEVELS[l] || state==='play' || state==='paused') return;
    level = l; store.set('boneSerpentLevel', l);
    document.querySelectorAll('#levels button').forEach(b => b.setAttribute('aria-checked', String(b.dataset.level===l)));
    $('lvlNote').textContent = LEVELS[l].note;
    best = bestFor(l); $('best').textContent = best;
    const chip = $('lvlChip'); chip.textContent = LEVELS[l].name; chip.classList.remove('easy','medium','fast'); chip.classList.add(l);
    if (state==='idle') $('ovText').textContent = introText(l);
    renderHistory();
  }
  function introText(l){
    return `Pumpkins grow your spine. Corn is worth 3 but vanishes fast. A new tombstone rises every ${LEVELS[l].stoneEvery} pumpkins.`;
  }
 
  let elapsed = 0, shownSec = -1, frameDt = 16.7;
  let snake, dir, queue, food, corn, stones, score, eaten, corns = 0, state = 'idle', last = 0, acc = 0, t = 0, deathAt = 0;
 
  // ---------- Game history ----------
  const HKEY = 'boneSerpentHistory', MAXH = 100;
  const FATE = {wall:'Wall', stone:'Tombstone', self:'Own bones', full:'Filled it'};
  // Saved games are checked one by one: anything damaged is repaired or skipped, so the page always loads.
  function cleanEntry(g){
    if (!g || typeof g!=='object' || !Number.isFinite(+g.score) || g.score===null || g.score==='') return null;
    const num = (v, d) => (v!==null && v!=='' && Number.isFinite(+v)) ? Math.max(0, Math.floor(+v)) : d;
    return {
      id: typeof g.id==='string' ? g.id : 'g'+Math.random().toString(36).slice(2),
      n: num(g.n, 0), score: num(g.score, 0), length: num(g.length, 0),
      pumpkins: num(g.pumpkins, 0), candies: num(g.candies, 0), time: num(g.time, null),
      level: LEVELS[g.level] ? g.level : 'medium',
      fate: FATE[g.fate] ? g.fate : 'wall',
      at: num(g.at, Date.now()),
    };
  }
  let history = [];
  try { const raw = JSON.parse(localStorage.getItem(HKEY) || '[]'); if (Array.isArray(raw)) history = raw.map(cleanEntry).filter(Boolean).slice(-MAXH); } catch(e) { history = []; }
  const fmtWhen = ms => {
    const d = new Date(ms), now = new Date();
    const time = d.toLocaleTimeString([], {hour:'numeric', minute:'2-digit'});
    const y = new Date(now); y.setDate(now.getDate()-1);
    const day = d.toDateString() === now.toDateString() ? 'Today'
      : d.toDateString() === y.toDateString() ? 'Yesterday'
      : d.toLocaleDateString([], {month:'short', day:'numeric'});
    return [day, time];
  };
  function fmtClock(sec){ sec=Math.max(0,Math.floor(sec)); const m=Math.floor(sec/60), s2=sec%60; return m+':'+String(s2).padStart(2,'0'); }
  function saveHistory(){ try { localStorage.setItem(HKEY, JSON.stringify(history)); } catch(e) {} }
  let latestGameId = null;
  function renderHistory(latestId){
    if (latestId) latestGameId = latestId;
    latestId = latestGameId;
    const n = history.length;
    // totals cover the level that is currently selected
    const mine = history.filter(g => g.level===level), m = mine.length;
    const total = mine.reduce((a,g)=>a+g.score,0);
    $('statsFor').textContent = `Totals for ${LEVELS[level].name} games`;
    $('statsFor').className = 'stats-for lvl-'+level;
    $('stGames').textContent = m;
    $('stAvg').textContent = m ? (total/m).toFixed(1) : '0';
    const times = mine.map(g=>g.time).filter(v=>typeof v==='number');
    $('stTime').textContent = times.length ? fmtClock(Math.max(...times)) : '0:00';
    $('stLong').textContent = m ? Math.max(...mine.map(g=>g.length)) : 0;
    const top = {};
    history.forEach(g => { const l = g.level || 'medium'; top[l] = Math.max(top[l] ?? -1, g.score); });
    const body = $('ledgerBody'); body.textContent = '';
    if (!n) {
      const tr = document.createElement('tr'), td = document.createElement('td');
      td.colSpan = document.querySelectorAll('.ledger thead th').length; td.className = 'empty'; td.textContent = 'No games yet. Your finished runs will be recorded here.';
      tr.appendChild(td); body.appendChild(tr); return;
    }
    history.slice().reverse().forEach(g => {
      const tr = document.createElement('tr');
      if (g.id === latestId) tr.className = 'latest';
      const gl = g.level || 'medium';
      const cells = [
        ['num opt-xs', String(g.n)],
        ['opt lvl-'+gl, LEVELS[gl].name],
        ['num', String(g.score)],
        ['num', typeof g.time==='number' ? fmtClock(g.time) : '–'],
        ['num opt', String(g.length)],
        ['num opt', String(g.pumpkins)],
        ['num opt', String(g.candies)],
      ];
      cells.forEach(([c,v],i) => {
        const td = document.createElement('td'); td.className = c; td.textContent = v;
        if (i===2) {
          if (g.score===top[gl] && top[gl]>0) { const s=document.createElement('span'); s.className='star'; s.textContent=' ★'; s.title='Best game on '+LEVELS[gl].name; td.appendChild(s); }
